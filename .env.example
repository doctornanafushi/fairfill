# --- True Markets Gateway ---
# Local: path to the API key file downloaded from the dashboard
TM_KEY_FILE=/home/you/.truemarkets/api-key.json
# Vercel: paste the whole JSON file content instead (one line)
# TM_API_KEY_JSON={"key_id":"...","private_key":{...},"algorithm":"ES256"}

# Gateway user used only for price quotes (no funds needed; orders are never executed)
TM_QUOTE_USER_ID=your-gateway-user-id

# --- Reference price (first available wins) ---
# PYTH_API_KEY=            # paid Pyth Pro key (optional)
FINNHUB_API_KEY=           # free key from finnhub.io

# --- Verdict thresholds (% above reference) ---
WARN_PCT=2
DANGER_PCT=10

# --- Solana RPC (reads the on-chain share multiplier of each token) ---
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# --- Wallet sign-in & buying ---
# Random secret for session cookies (32+ chars):  openssl rand -base64 48
SESSION_SECRET=
# Signer key that approves your users' Gateway wallet transactions (quickstart's signer-key.json)
TM_SIGNER_KEY_FILE=/home/you/.truemarkets/signer-key.json
# TM_SIGNER_KEY_JSON={"signer_public_key":"...","signer_private_key":"..."}   # for Vercel
# Only if the organization id cannot be read from the token:
# TM_ORG_ID=
